{
	"name": "@charliewilco/regex",
	"version": "0.0.3",
	"license": "Unlicense",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"typings": "dist/index.d.ts",
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"prepublish": "npm run build",
		"prebuild": "rm -rf dist",
		"build": "tsup",
		"test": "jest --verbose --runInBand",
		"test:ci": "npm test -- --ci --no-cache"
	},
	"dependencies": {
		"tlds": "^1.233.0"
	},
	"devDependencies": {
		"@types/jest": "^29.2.3",
		"@types/tlds": "^1.207.0",
		"esbuild": "^0.15.14",
		"jest": "^29.3.1",
		"prettier": "^2.7.1",
		"ts-jest": "^29.0.3",
		"tsup": "^6.5.0",
		"typescript": "^4.9.3"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 95,
		"singleQuote": false,
		"semi": true,
		"bracketSpacing": true,
		"jsxBracketSameLine": true
	},
	"jest": {
		"preset": "ts-jest"
	},
	"tsup": {
		"entry": [
			"src/index.ts"
		],
		"splitting": false,
		"sourcemap": true,
		"clean": true,
		"dts": true,
		"minify": true,
		"format": [
			"cjs",
			"esm"
		]
	}
}
