{
  "name": "@charliewilco/regex",
  "version": "0.0.3",
  "description": "A tiny collection of reusable regular expressions for common string patterns.",
  "license": "Unlicense",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.3.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliewilco/regex.git"
  },
  "bugs": {
    "url": "https://github.com/charliewilco/regex/issues"
  },
  "homepage": "https://github.com/charliewilco/regex#readme",
  "keywords": [
    "regex",
    "regexp",
    "validation",
    "typescript"
  ],
  "scripts": {
    "clean": "rm -rf dist src/index.js src/index.js.map src/index.cjs src/index.cjs.map",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --root ./src --entry-naming [name].js --target node --format esm --sourcemap=external",
    "build:cjs": "bun build ./src/index.ts --outdir ./dist --root ./src --entry-naming [name].cjs --target node --format cjs --sourcemap=external",
    "build:types": "tsc --project tsconfig.build.json",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:ci": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:test && bun run test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.12",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2"
  },
  "prettier": {
    "printWidth": 95,
    "singleQuote": false,
    "semi": true,
    "bracketSpacing": true
  }
}
