{
  "name": "@charliewilco/regex",
  "version": "0.1.0",
  "description": "A tiny collection of reusable regular expressions for common string patterns.",
  "license": "Unlicense",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.5.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": "charliewilco/regex",
  "bugs": {
    "url": "https://github.com/charliewilco/regex/issues"
  },
  "homepage": "https://github.com/charliewilco/regex#readme",
  "keywords": [
    "regex",
    "regexp",
    "validation",
    "typescript"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.ts",
    "test:ci": "node --experimental-test-coverage --test test/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:test && npm run test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2"
  },
  "prettier": {
    "printWidth": 95,
    "singleQuote": false,
    "semi": true,
    "bracketSpacing": true
  }
}
